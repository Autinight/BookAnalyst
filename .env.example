# MinerU parsing API token. See docs/workflow.md.
MINERU_API_TOKEN=

# Optional custom LLM connection credential.
LLM_CUSTOM_API_KEY=

# Optional official runtime override; otherwise use codex from PATH.
# BOOKANALYST_CODEX_BIN=

# Optional fallback for proxy fake-DNS failures on the official result CDN.
# Keeps original HTTPS Host and TLS SNI verification.
# MINERU_DOWNLOAD_PUBLIC_DNS=1
